{
  "expo": {
    "name": "Arenile",
    "slug": "arenile-mobile",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/brand/icon.png",
    "scheme": "arenile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.arenile.mobile",
      "supportsTablet": true,
      "requireFullScreen": false,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.arenile.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0B2542",
        "foregroundImage": "./assets/brand/android-foreground.png",
        "monochromeImage": "./assets/brand/android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "locales": {
      "it": "./native-locales/it.json",
      "en": "./native-locales/en.json",
      "de": "./native-locales/de.json",
      "fr": "./native-locales/fr.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B2542",
          "image": "./assets/brand/splash.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-camera",
        {
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "mode": "production",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "./plugins/with-fcm-privacy",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.app.arenile.mobile",
          "enableAndroid": true,
          "enablePushNotifications": false,
          "frequentUpdates": false,
          "widgets": [
            {
              "name": "DaySummary",
              "displayName": "Arenile",
              "description": "Riepilogo del giorno: arrivi, presenti, da saldare, postazioni libere",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"],
                "initialLayout": "./src/widgets/day-summary-widget.ios.tsx"
              },
              "android": {
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "minWidth": 110,
                "minHeight": 110,
                "resizeMode": "both",
                "initialLayout": "./src/widgets/day-summary-widget.android.tsx"
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
